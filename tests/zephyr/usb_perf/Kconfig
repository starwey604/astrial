# Application-level Kconfig for the Astrial USB performance firmware.
# Deliberately self-contained: this app does not use the Zephyr tree's
# samples/subsys/usb/common Kconfig (sample_usbd).

menu "Astrial USB test options"
	depends on USB_DEVICE_STACK_NEXT

config ASTRIAL_USB_VID
	hex "USB Vendor ID"
	default 0x2fe3
	help
	  Vendor ID the firmware enumerates with. The Astrial performance
	  tools default to 0x2fe3:0x574d. This Zephyr Project VID is acceptable
	  for a lab fixture, never for anything that ships.

config ASTRIAL_USB_PID
	hex "USB Product ID"
	default 0x574d
	help
	  Product ID for the separate performance test device.

config ASTRIAL_USB_MANUFACTURER
	string "Manufacturer string"
	default "Astrial"

config ASTRIAL_USB_PRODUCT
	string "Product string"
	default "Astrial USB Bulk Echo"

endmenu

source "Kconfig.zephyr"
